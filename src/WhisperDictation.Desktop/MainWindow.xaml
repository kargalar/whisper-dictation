<Window x:Class="WhisperDictation.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:core="clr-namespace:WhisperDictation.Core;assembly=WhisperDictation.Core"
        Title="{x:Static core:UiText.Title}" Width="980" Height="900" MinWidth="760" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        StateChanged="WindowStateChanged" Style="{StaticResource BaseWindowStyle}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="16" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Background="{StaticResource PanelBrush}" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image x:Name="TitleIcon" Width="20" Height="20" Stretch="Uniform" />
                <TextBlock Text="{x:Static core:UiText.Title}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="9,0,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,7,0">
                <Button Style="{StaticResource TitleBarButton}" Content="—" FontSize="16"
                        ToolTip="{x:Static core:UiText.MinimizeWindow}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="MinimizeWindow" />
                <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Content="□" FontSize="13"
                        ToolTip="{x:Static core:UiText.MaximizeWindow}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="ToggleMaximizeWindow" />
                <Button Style="{StaticResource TitleBarButton}" Content="×" FontSize="17"
                        ToolTip="{x:Static core:UiText.CloseWindow}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseWindow" />
            </StackPanel>
        </DockPanel>
        <ScrollViewer Grid.Row="1" Margin="28" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <DockPanel Margin="0,0,0,22" LastChildFill="True">
                <Border DockPanel.Dock="Right" Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="14,10"
                        VerticalAlignment="Center" Margin="18,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Status}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Engine}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Static core:UiText.Subtitle}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                </StackPanel>
            </DockPanel>

            <Border Background="{StaticResource PanelBrush}" CornerRadius="20" Padding="24" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource KeycapBrush}" CornerRadius="16" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="{x:Static core:UiText.Hotkey}" FontSize="12"
                                       Foreground="{StaticResource KeycapTextBrush}" Opacity="0.7" />
                            <TextBlock Text="{Binding ActiveHotkey}" FontSize="23"
                                       Foreground="{StaticResource KeycapTextBrush}" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Grid.Row="1" Text="{x:Static core:UiText.CancelHelp}"
                               Style="{StaticResource MutedText}" FontSize="11" Margin="2,12,0,0" />
                </Grid>
            </Border>

            <Border Background="{StaticResource PanelBrush}" CornerRadius="20" Padding="22" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="{x:Static core:UiText.Copy}" Command="{Binding CopyLastCommand}"
                                IsEnabled="{Binding HasText}" Margin="0" />
                        <TextBlock Text="{x:Static core:UiText.LastResult}" VerticalAlignment="Center" Style="{StaticResource MutedText}"
                                   FontSize="11" FontWeight="SemiBold" />
                    </DockPanel>
                    <Grid Grid.Row="1" MinHeight="116">
                        <TextBox Text="{Binding LastText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="16"
                                 VerticalScrollBarVisibility="Auto" Padding="16" />
                        <TextBlock Text="{x:Static core:UiText.NoResult}" Margin="16" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasText}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <Border Background="{StaticResource PanelBrush}" CornerRadius="20" Padding="22" Margin="0,0,0,14">
                <StackPanel IsEnabled="{Binding CanConfigure}">
                    <TextBlock Text="{x:Static core:UiText.SettingsTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,18" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Static core:UiText.Model}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" DisplayMemberPath="Name" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{x:Static core:UiText.Engine}" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding ComputeChoices}" SelectedItem="{Binding SelectedCompute}" DisplayMemberPath="Name" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{x:Static core:UiText.Microphone}" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Content="{x:Static core:UiText.RefreshMicrophones}"
                                Command="{Binding RefreshMicrophonesCommand}" Margin="10,0,0,0" />
                        <ComboBox ItemsSource="{Binding Microphones}" SelectedItem="{Binding SelectedMicrophone}"
                                  DisplayMemberPath="Name" />
                    </DockPanel>
                    <TextBlock Text="{x:Static core:UiText.Hotkey}" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{x:Static core:UiText.HotkeyHint}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,6" />
                    <Button Content="{Binding HotkeyCaptureDisplay}" Click="BeginHotkeyCapture"
                            LostKeyboardFocus="CancelHotkeyCapture" HorizontalContentAlignment="Left" Margin="0" />
                    <CheckBox Style="{StaticResource StartupCheckBox}" Content="{x:Static core:UiText.StartWithWindows}"
                              IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Margin="0,16,0,0" />
                    <TextBlock Text="{x:Static core:UiText.StartWithWindowsHelp}" Style="{StaticResource MutedText}"
                               FontSize="11" Margin="30,5,0,0" />
                    <Button Content="{x:Static core:UiText.ApplySettings}" Command="{Binding ApplySettingsCommand}"
                            HorizontalAlignment="Left" Background="{StaticResource PrimaryButtonBrush}"
                            Foreground="{StaticResource PrimaryButtonTextBrush}" Margin="0,18,0,0" />
                </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" CornerRadius="20" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="210" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="{x:Static core:UiText.ClearHistory}"
                                Command="{Binding ClearHistoryCommand}" Margin="0" />
                        <TextBlock Text="{x:Static core:UiText.HistoryTitle}" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Grid.Row="1" Text="{x:Static core:UiText.HistoryHelp}" Style="{StaticResource MutedText}"
                               FontSize="11" Margin="0,0,0,12" />
                    <ListBox Grid.Row="2" ItemsSource="{Binding History}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="14" Margin="0,0,0,8">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,7">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="{x:Static core:UiText.Copy}"
                                                        Command="{Binding DataContext.CopyEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}" Padding="12,6" FontSize="11" />
                                                <Button Content="{x:Static core:UiText.Delete}"
                                                        Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}" Padding="12,6" Margin="0" FontSize="11" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayDate}" Style="{StaticResource MutedText}" FontSize="11" />
                                                <TextBlock Text="{Binding DisplayModel}" Foreground="{StaticResource SubtleTextBrush}"
                                                           Margin="12,0,0,0" FontSize="11" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Text}" FontSize="14" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
